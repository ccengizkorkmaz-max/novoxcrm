# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

debug-db.ts
debug-db.cjs

# Google Drive / Backup Sync Temp Files
.tmp.driveupload
.tmp.drivedownload
*.tmp

google-indexer-key.json

# scratch scripts (may contain secrets)
scratch/
.env*.local

# ============================================
# Root debug/test scripts (not part of the app)
# ============================================
/*.js
/*.cjs
/*.mjs
/*.ts
# Keep config files
!next.config.ts
!next-env.d.ts

# ============================================
# Data files - must never be in repo (PII risk)
# ============================================
*.xlsx
*.csv
*.sql
*.log
*.png
/burak.json
/calls_output.json
/data.json
/error_log.json
/kubra_assigned.json
/kubra_source.json
/missing_contacts.json
/missing_leads_from_excel.json
/sales_assignment_backup.json

# Reports (generated, not source code)
/reports/
