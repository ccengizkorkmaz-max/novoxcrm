{
  "bypassProtection": {
    "routes": [
      "/api/webhooks/:path*",
      "/api/leads/external",
      "/api/cron/:path*"
    ]
  },
  "crons": [
    {
      "path": "/api/cron/outreach-daily",
      "schedule": "0 9,12,15 * * 1-5"
    },
    {
      "path": "/api/cron/outreach",
      "schedule": "*/5 5-21 * * 1-6"
    },
    {
      "path": "/api/seo/ping-engines",
      "schedule": "0 6 * * *"
    }
  ]
}
